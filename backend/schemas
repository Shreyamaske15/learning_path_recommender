"""
Pydantic schemas for API request/response bodies.
"""
from typing import List, Optional
from pydantic import BaseModel, Field


class LearnerCreate(BaseModel):
    name: str
    email: Optional[str] = None
    goal: str = ""
    interests: List[str] = Field(default_factory=list)
    experience_level: str = "beginner"
    completed_course_ids: List[str] = Field(default_factory=list)
    weekly_hours: int = 5


class LearnerUpdate(BaseModel):
    goal: Optional[str] = None
    interests: Optional[List[str]] = None
    experience_level: Optional[str] = None
    completed_course_ids: Optional[List[str]] = None
    weekly_hours: Optional[int] = None
    raw_profile_notes: Optional[str] = None


class LearnerOut(BaseModel):
    id: str
    name: str
    email: Optional[str] = None
    goal: str
    interests: List[str]
    experience_level: str
    completed_course_ids: List[str]
    weekly_hours: int

    class Config:
        from_attributes = True


class ChatRequest(BaseModel):
    learner_id: str
    message: str


class ChatResponse(BaseModel):
    reply: str
    updated_profile: LearnerOut
    profile_fields_updated: List[str] = Field(default_factory=list)


class CourseOut(BaseModel):
    id: str
    title: str
    category: str
    description: str
    tags: List[str]
    difficulty: str
    duration_hours: int
    prerequisites: List[str]


class RecommendationItem(BaseModel):
    course: CourseOut
    score: float
    explanation: Optional[str] = None


class MilestoneOut(BaseModel):
    milestone_number: int
    title: str
    courses: List[CourseOut]
    total_hours: int


class LearningPathOut(BaseModel):
    learner_id: str
    milestones: List[MilestoneOut]
    total_courses: int
    total_hours: int
    estimated_weeks: float


class ExplainRequest(BaseModel):
    learner_id: str
    course_id: str


class QueryRequest(BaseModel):
    learner_id: str
    question: str


class ProgressUpdate(BaseModel):
    learner_id: str
    course_id: str
    status: str  # not_started | in_progress | completed


class DashboardOut(BaseModel):
    learner_id: str
    total_recommended: int
    completed: int
    in_progress: int
    not_started: int
    completion_pct: float
    hours_completed: int
    skill_categories: dict
    next_recommended: List[CourseOut]
